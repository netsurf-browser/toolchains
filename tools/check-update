#!/usr/bin/env python3

import argparse
from contextlib import suppress
from html.parser import HTMLParser
import json
import os
import re
from urllib.parse import urljoin, urlparse

import httpx


class IndexParser(HTMLParser):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._base = None
        self._links = []
        self._tagstack = []
        self._textcontent = []

    @property
    def base(self) -> str | None:
        return self._base

    @property
    def links(self) -> list[str]:
        return self._links

    @property
    def textcontent(self) -> str:
        return "".join(self._textcontent)

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str]]):
        self._tagstack.append(tag)
        if tag == "base" and self._base is None:
            hrefs = [val for attr, val in attrs if attr == "href"]
            if hrefs:
                self._base = hrefs[0]
            return

        if tag == "a":
            hrefs = [val for attr, val in attrs if attr == "href"]
            if hrefs:
                self._links.append(hrefs[0])

    def handle_endtag(self, tag: str):
        # Remove most recently opened matching tag (if any) from the stack
        self._tagstack.reverse()
        with suppress(ValueError):
            self._tagstack.remove(tag)
        self._tagstack.reverse()

    def handle_data(self, data: str):
        if ("script" in self._tagstack or "style" in self._tagstack):
            return
        self._textcontent.append(data)


class VersionNumeric(tuple):
    def __new__(cls, vstr: str):
        return super(VersionNumeric, cls).__new__(
            cls, (int(val) for val in vstr.split("."))
        )

class VersionSymbolic(str):
    def __new__(cls, vstr: str):
        return super(VersionSymbolic, cls).__new__(cls, vstr)


class UpdateCheck:
    def __init__(self, args):
        self._args = args

    def _parse_html_index(
        self, response: httpx.Response, vcls: VersionNumeric | VersionSymbolic
    ) -> dict[str, str | tuple]:
        parser = IndexParser()
        parser.feed(response.text)
        parser.close()

        newest = current = vcls(self._args.current_version)
        pattern = re.compile(self._args.match_pattern)
        claims, href = None, None
        for link in parser.links:
            basename = link.rsplit("/", 1)[-1]
            mtch = pattern.fullmatch(basename)
            if not mtch:
                continue
            candidate = vcls(mtch[1])
            if candidate > newest:
                newest = candidate
                href = link

        if newest != current:
            chosen = href.rsplit("/", 1)[-1]
            sig_claim, sig = None, None
            for link in parser.links:
                basename = link.rsplit("/", 1)[-1]
                if basename in (f"{chosen}.asc", f"{chosen}.sig"):
                    sig = link
                    break
            if sig is not None:
                sig = urljoin(parser.base or self._args.index_url, sig)
                sig_claim = { "type": "signature", "url": sig }

            digest_claim = None
            digest = re.search(
                r"\s([0-9a-fA-F]+)\s+" + chosen,
                parser.textcontent
            )
            if digest is not None and len(digest[1]) == 64:
                digest_claim = {
                    "type": "digest", "value": f"sha256:{digest[1]}"
                }

            href = urljoin(parser.base or self._args.index_url, href)
            if digest_claim is not None or sig_claim is not None:
                claims = []
                if digest_claim is not None:
                    claims.append(digest_claim)
                if sig_claim is not None:
                    claims.append(sig_claim)

        return {
            "component": self._args.component,
            "current": current,
            "newest": newest,
            "url": href,
            "claims": claims,
        }

    def _parse_github_releases(
        self, response: httpx.Response, vcls: VersionNumeric | VersionSymbolic
    ) -> dict[str, str | tuple]:
        newest = current = vcls(self._args.current_version)
        pattern = re.compile(self._args.match_pattern)
        claims, href = None, None
        for release in response.json():
            chosen = None
            for asset in release["assets"]:
                mtch = pattern.fullmatch(asset["name"])
                if not mtch:
                    continue
                candidate = vcls(mtch[1])
                if candidate > newest:
                    newest = candidate
                    chosen = asset
            if chosen is not None:
                sig = None
                for sigasset in release["assets"]:
                    if sigasset["name"] in (
                        f'{chosen["name"]}.asc',
                        f'{chosen["name"]}.sig',
                    ):
                        sig = sigasset
                        break
                href = chosen["browser_download_url"]
                claims = [
                    { "type": "digest", "value": chosen["digest"] }
                ]
                if sig is not None:
                    claims.append(
                        {
                            "type": "signature",
                            "url": sig["browser_download_url"],
                        }
                    )

        return {
            "component": self._args.component,
            "current": current,
            "newest": newest,
            "url": href,
            "claims": claims,
        }

    def run(self):
        vcls = VersionNumeric
        if "." not in self._args.current_version:
            vcls = VersionSymbolic

        with httpx.Client(http2=True, follow_redirects=True) as client:
            headers = {}
            if urlparse(self._args.index_url).hostname == "api.github.com":
                if "GH_TOKEN" in os.environ:
                    headers["Authorization"] = (
                        f'Bearer {os.environ["GH_TOKEN"]}'
                    )
                parser = self._parse_github_releases
            else:
                parser = self._parse_html_index

            response = client.get(self._args.index_url, headers=headers)
            response.raise_for_status()

            data = parser(response, vcls)

            result = {}
            for key, value in data.items():
                if isinstance(value, VersionNumeric):
                    result[key] = ".".join(str(v) for v in value)
                else:
                    result[key] = value
            print(json.dumps(result))


def main():
    parser = argparse.ArgumentParser(
        description="Check for new versions of a component"
    )
    parser.add_argument("component")
    parser.add_argument("current_version")
    parser.add_argument("index_url")
    parser.add_argument("match_pattern")
    args = parser.parse_args()
    UpdateCheck(args).run()


if __name__ == "__main__":
    main()
