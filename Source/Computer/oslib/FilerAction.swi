TITLE FilerAction;
AUTHOR "Jonathan Coxhead, jonathan@doves.demon.co.uk, 18 May 1995";

// NEEDS OS, WIMP;      // TV 20030226
NEEDS OS, Wimp;

TYPE FilerAction_Operation = .Int;
CONST
   FilerAction_Copy      = FilerAction_Operation: 0,
   FilerAction_MoveLocal = FilerAction_Operation: 1,
   FilerAction_Delete    = FilerAction_Operation: 2,
   FilerAction_Access    = FilerAction_Operation: 3,
   FilerAction_SetType   = FilerAction_Operation: 4,
   FilerAction_Count     = FilerAction_Operation: 5,
   FilerAction_Move      = FilerAction_Operation: 6,
   FilerAction_CopyLocal = FilerAction_Operation: 7,
   FilerAction_Stamp     = FilerAction_Operation: 8,
   FilerAction_Find      = FilerAction_Operation: 9;

TYPE FilerAction_Flags = .Bits;
CONST
   FilerAction_Verbose 	      	    = FilerAction_Flags: %1,
   FilerAction_Confirm 	      	    = FilerAction_Flags: %10,
   FilerAction_Force   	      	    = FilerAction_Flags: %100,
   FilerAction_Newer   	      	    = FilerAction_Flags: %1000,
   FilerAction_Recurse 	      	    = FilerAction_Flags: %10000,
   FilerAction_ConfirmDeletesOnly   = FilerAction_Flags: %100000 "RISC OS 4+",
   FilerAction_Faster               = FilerAction_Flags: %1000000 "RISC OS 4+",
   FilerAction_NeverProxy           = FilerAction_Flags: %10000000 "RISC OS Select";

SWI FilerAction_SendSelectedDirectory =
   (  NUMBER 0x40F80 "Sends a message specifying the directory containing the
            selection",
      ENTRY
      (  R0 = Wimp_T: task,
         R1 -> .String: name
   )  );

SWI FilerAction_SendSelectedFile =
   (  NUMBER 0x40F81 "Sends a message specifying a selected file within the
            given directory",
      ENTRY
      (  R0 = Wimp_T: task,
         R1 -> .String: leaf_name
   )  );

SWI FilerAction_SendStartOperation =
   (  NUMBER 0x40F82 "Sends a message containing information to start an
            operation - see individual reason codes",
      ABSENT
   );

SWI FilerActionSendStartOperation_Copy =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_Copy "Sends a message to start a copy",
         R2 = FilerAction_Flags: flags,
         R3 -> .String: destination,
         R4 = .Int: size
   )  );

SWI FilerActionSendStartOperation_MoveLocal =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_MoveLocal "Sends a message to start a move (by renaming)",
         R2 = FilerAction_Flags: flags,
         R3 -> .String: destination,
         R4 = .Int: size
   )  );

SWI FilerActionSendStartOperation_Delete =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_Delete "Sends a message to start a delete",
         R2 = FilerAction_Flags: flags,
         R4 # 0
   )  );

SWI FilerActionSendStartOperation_Access =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_Access "Sends a message to start an access modification",
         R2 = FilerAction_Flags: flags,
         R3 -> .Int: access,
         R4 # 4
   )  );

SWI FilerActionSendStartOperation_SetType =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_SetType "Sends a message to start a set type",
         R2 = FilerAction_Flags: flags,
         R3 -> .Bits: file_type,
         R4 # 4
   )  );

SWI FilerActionSendStartOperation_Count =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_Count "Sends a message to start a count",
         R2 = FilerAction_Flags: flags,
         R4 # 0
   )  );

SWI FilerActionSendStartOperation_Move =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_Move "Sends a message to start a move (by copying and deleting)",
         R2 = FilerAction_Flags: flags,
         R3 -> .String: destination,
         R4 = .Int: size
   )  );

SWI FilerActionSendStartOperation_CopyLocal =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_CopyLocal "Sends a message to start a copy within a directory",
         R2 = FilerAction_Flags: flags,
         R3 -> .String: destination,
         R4 = .Int: size
   )  );

SWI FilerActionSendStartOperation_Stamp =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_Stamp "Sends a message to start a stamp",
         R2 = FilerAction_Flags: flags,
         R4 # 0
   )  );

SWI FilerActionSendStartOperation_Find =
   (  NUMBER 0x40F82,
      ENTRY
      (  R0 = Wimp_T: task,
         R1 # FilerAction_Find "Sends a message to start a file search",
         R2 = FilerAction_Flags: flags,
         R3 -> .String: file_name,
         R4 = .Int: size
   )  )
