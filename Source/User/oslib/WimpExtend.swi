TITLE WimpExtend;
AUTHOR "Richard Sargeant, sargeant@arcade.demon.co.uk, 04-Mar-1999";

NEEDS OS, OSSpriteOp, Wimp;

TYPE
   WimpExtend_FurnitureSizes =
   .Struct
   (  Wimp_W: w,
      OS_Box: border_widths,
      .Int: back_width,
      .Int: close_width,
      .Int: reserved1,
      .Int: title_width,
      .Int: reserved2,
      .Int: iconise_width,
      .Int: toggle_size_width,
      .Int: toggle_size_height,
      .Int: vertical_scroll_upper_gap,
      .Int: up_arrow_height,
      .Int: vertical_scroll_well_height,
      .Int: down_arrow_height,
      .Int: vertical_scroll_lower_gap,
      .Int: adjust_size_height,
      .Int: adjust_size_width,
      .Int: horizontal_scroll_right_gap,
      .Int: right_arrow_width,
      .Int: horizontal_scroll_well_width,
      .Int: left_arrow_width,
      .Int: horizontal_scroll_left_gap
   );

TYPE WimpExtendGetSpriteColourMap_Flags = .Bits;
CONST
   WimpExtendGetSpriteColourMapFlags_SelectedItem  = WimpExtendGetSpriteColourMap_Flags: 0x00200000,
   WimpExtendGetSpriteColourMapFlags_FadedItem     = WimpExtendGetSpriteColourMap_Flags: 0x00400000,
   WimpExtendGetSpriteColourMapFlags_PtrOver       = WimpExtendGetSpriteColourMap_Flags: 0x00800000,
   WimpExtendGetSpriteColourMapFlags_FGColourShift = .Int: 24,
   WimpExtendGetSpriteColourMapFlags_BGColourShift = .Int: 28;

SWI Wimp_Extend =
   (  NUMBER 0x400FB "For internal use only",
      ABSENT
   ),

// WimpExtend_LocateWorkspace = ( NUMBER 0x400FB, //undocumented
//       ENTRY (R0 # 1 "For internal use only; returns address of
//                the primary block of workspace used by the Wimp"),
//       EXIT (R0! = .Asm: workspace)),

WimpExtend_GetParent =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 6 "Finds the window's parent - nested Wimp / RISC OS 3.8+",
         R1 = Wimp_W: w
      ),
      EXIT
      (  R0! = Wimp_W: parent
   )  ),

WimpExtend_GetFrontChild =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 7 "Finds the window's frontmost child; this call may also
                 be used to enquire about the top-level stack - nested
                 Wimp / RISC OS 3.8+",
         R1 = Wimp_W: w
      ),
      EXIT
      (  R0! = Wimp_W: child
   )  ),

WimpExtend_GetBackChild =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 8 "Finds the window's backmost child; this call  may also be
                 used to enquire about the top-level stack - nested Wimp /
                 RISC OS 3.8+",
         R1 = Wimp_W: w
      ),
      EXIT
      (  R0! = Wimp_W: child
   )  ),

WimpExtend_GetSiblingUnder =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 9 "Finds the window's sibling that's immediately behind - nested
                 Wimp / RISC OS 3.8+",
         R1 = Wimp_W: w
      ),
      EXIT
      (  R0! = Wimp_W: sibling
   )  ),

WimpExtend_GetSiblingOver =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 10 "Finds the window's sibling that's immediately in front -
                  nested Wimp / RISC OS 3.8+",
         R1 = Wimp_W: w
      ),
      EXIT
      (  R0! = Wimp_W: sibling
   )  ),
      
WimpExtend_GetFurnitureSizes =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 11 "Finds the sizes of the window's various items of furniture
                  - RISC OS 4+",
         R1 = .Ref WimpExtend_FurnitureSizes: sizes
   )  ),
      
WimpExtend_GetSpriteAddress =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 256 "Lookup a sprite using the same algorithm as the Window
                   Manager - RISC OS Select",
         R1 -> OSSpriteOp_Area: sprite_area,
         R2 -> .Char: sprite_name
      ),
      EXIT
      (  R1 -> OSSpriteOp_Area: area,
         R2 -> OSSpriteOp_Header: sprite
   )  ),

WimpExtend_GetModeSuffix =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 257 "Append filename with mode suffix - RISC OS Select",
         R1 = .Ref .String: filename
      ),
      EXIT
      (  R0 -> .String: buffer1,
         R1 -> .String: buffer2
   )  ),

WimpExtend_GetSpriteColourMap =
   (  NUMBER 0x400FB,
      ENTRY
      (  R0 # 258 "Read colourmap translation for rendering sprite - RISC OS Select",
         R1 = WimpExtendGetSpriteColourMap_Flags: flags,
         R2 = Wimp_W: w,
         R3 -> .String: validation,
         R4 = OS_Colour: background
      ),
      EXIT
      (  R0 -> OSSpriteOp_ColourMapping: colourmap
   )  )
