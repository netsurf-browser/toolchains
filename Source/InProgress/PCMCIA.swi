TITLE PCMCIA;

NEEDS OS;

CONST
   Error_PCMCIAHWDriverNought = .Bits: 0x808900;

CONST
   Error_PCMCIAManagerNought = .Bits: 0x808A00;

CONST PCMCIA_TupleNameLimit = .Int: 256;

TYPE PCMCIA_T;

TYPE PCMCIA_ScatterList;

SWI PCMCIA_VersionFeatures =
   (  NUMBER 0x47500 "Returns the PCMCIA Manager's version number
            and supported features",
      EXIT (R0 = .Bits: version_no,
            R1 = .Bits: features)
   );

SWI PCMCIA_Drivers =
   (  NUMBER 0x47501 "Allows a PCMCIA driver to register and
            deregister itself with the PCMCIA Manager -
      see individual reason codes",
      ABSENT
   );

SWI PCMCIADrivers_RegisterHardwareDriver =
   (  NUMBER 0x47501,
      ENTRY (R0 # 0 "Allows a PCMCIA hardware driver to register
            itself with the PCMCIA Manager",
            R1 = .Asm: handler,
            R2 = .Ref Void: workspace)
   );

SWI PCMCIADrivers_DeregisterHardwareDriver =
   (  NUMBER 0x47501,
      ENTRY (R0 # 1 "Allows a PCMCIA hardware driver to deregister
            itself with the PCMCIA Manager",
            R1 = .Asm: handler,
            R2 = .Ref Void: workspace)
   );

SWI PCMCIADrivers_RegisterPCCardDriver =
   (  NUMBER 0x47501,
      ENTRY (R0 # 2 "Allows a PC card driver to register
            itself with the PCMCIA Manager",
            R1 -> .String: driver_id,
            R2 = .Bits: version_flags,
            R3 = .Asm: fn_code,
            R4 = .Asm: read_code,
            R5 = .Asm: write_code,
            R6 = .Asm: erase_code,
            R7 = .Asm: irq_code,
            R8 = .Ref Void: workspace)
   );

SWI PCMCIADrivers_DeregisterPCCardDriver =
   (  NUMBER 0x47501,
      ENTRY (R0 # 3 "Allows a PC card driver to deregister
            itself with the PCMCIA Manager",
            R1 = .Asm: handler,
            R2 = .Ref Void: workspace) 
   );

SWI PCMCIA_CIS =
   (  NUMBER 0x47502 "Manipulates some or all of a PC card's CIS
            (Card Information Structure) -
      see individual reason codes",
      ABSENT
   );

SWI PCMCIACIS_GetLength =
   (  NUMBER 0x47502,
      ENTRY (R0 # 0 "Returns the length of the CIS",
            R1 = .Int: slot_no,
            R2 -> .Data: cis,
            R3 = .Int: cis_length),
      EXIT (R3! = .Int: cis_length_out)
   );

SWI PCMCIACIS_Read =
   (  NUMBER 0x47502,
      ENTRY (R0 # 1 "Reads the entire CIS",
            R1 = .Int: slot_no,
            R2 = .Ref .Data: cis,
            R3 = .Int: cis_length),
      EXIT (R3! = .Int: cis_length_out)
   );

SWI PCMCIACIS_Write =
   (  NUMBER 0x47502,
      ENTRY (R0 # 2 "Writes the entire CIS",
            R1 = .Int: slot_no,
            R2 -> .Data: cis,
            R3 = .Int: cis_length)
   );

SWI PCMCIACIS_ReadTuple =
   (  NUMBER 0x47502,
      ENTRY (R0 # 3 "Reads a single tuple from a CIS",
            R1 = .Int: slot_no,
            R2 -> .Data: cis,
            R3 = .Int: cis_length,
            R4 = .Int: cis_limit,
            R6 = PCMCIA_T: t,
            R7 = .Ref .Data: tuple)
   );

SWI PCMCIACIS_InsertTuple =
   (  NUMBER 0x47502,
      ENTRY (R0 # 4 "Inserts a tuple into a CIS",
            R1 = .Int: slot_no,
            R2 = .Ref .Data: cis,
            R3 = .Int: cis_length,
            R4 = .Int: cis_limit,
            R6 = PCMCIA_T: t,
            R7 -> .Data: tuple),
      EXIT (R3! = .Int: cis_length_out)
   );

SWI PCMCIACIS_FindTuple =
   (  NUMBER 0x47502,
      ENTRY (R0 # 5 "Looks for a specified tupe in a CIS",
            R1 = .Int: slot_no,
            R2 -> .Data: cis,
            R3 = .Int: cis_length,
            R4 = .Int: cis_limit,
            R5 = .Int: tuple_id,
            R6 = .Int: sequence_no),
      EXIT (R6! = PCMCIA_T: t)
   );

SWI PCMCIACIS_DeleteTuple =
   (  NUMBER 0x47502,
      ENTRY (R0 # 6 "Deletes a tuple from a CIS",
            R1 = .Int: slot_no,
            R2 = .Ref .Data: cis,
            R3 = .Int: cis_length,
            R4 = .Int: cis_limit,
            R6 = PCMCIA_T: t),
      EXIT (R3! = .Int: cis_length_out)
   );

TYPE PCMCIA_AccessFlags = .Bits;
CONST
   PCMCIA_AccessType             = PCMCIA_AccessFlags: %1111,
   PCMCIA_AccessTypeShift        = .Int: 4,
   PCMCIA_AccessTypePhysical     = .Int: 0,
   PCMCIA_AccessTypeRaw          = .Int: 1,
   PCMCIA_AccessGivenScatterList = PCMCIA_AccessFlags: %10000,
   PCMCIA_AccessAttributeMemory  = PCMCIA_AccessFlags: %100000;

SWI PCMCIA_Read =
   (  NUMBER 0x47503 "Reads data from the memory space of the
            specified PC card",
      ENTRY (R0 = PCMCIA_AccessFlags: flags,
            R1 = .Int: slot_no,
            R2 -> .Data: from,
            R3 = .Ref .Data: to,
            R4 = .Int: byte_count), 
      EXIT (R3 = .Ref .Data: next_to,
            R4! = .Int: unread)
   );

SWI PCMCIA_Write =
   (  NUMBER 0x47504 "Writes data to the memory space of the specified
            PC card",
      ENTRY (R0 = PCMCIA_AccessFlags: flags,
            R1 = .Int: slot_no,
            R2 = .Ref .Data: to,
            R3 -> .Data: from,
            R4 = .Int: byte_count), 
      EXIT (R3 = .Ref .Data: next_from,
            R4! = .Int: unwritten)
   );

SWI PCMCIA_Erase =
   (  NUMBER 0x47505 "Erases a memory block on the PCMCIA card",
      ENTRY (R0 = PCMCIA_AccessFlags: flags,
            R1 = .Int: slot_no,
            R2 = .Ref .Data: start,
            R4 = .Int: block_count), 
      EXIT (R3 = .Int: erased,
            R4! = .Int: unerased)
   );

TYPE PCMCIA_PowerFlags = .Bits;
CONST
   PCMCIA_PowerWriteStatus   = .Bits: 0,
   PCMCIA_PowerWriteStatus   = .Bits: 1,
   PCMCIA_PowerStatus        = .Bits: %110,
   PCMCIA_PowerStatusShift   = .Int: 1,
   PCMCIA_PowerStatusOff     = .Int: 0,
   PCMCIA_PowerStatusStandby = .Int: 1,
   PCMCIA_PowerStatusOn      = .Int: 3;

SWI PCMCIA_PowerOp =
   (  NUMBER 0x47506 "Provides PCMCIA power-saving operations",
      ENTRY (R0 = PCMCIA_PowerFlags: flags,
            R1 = .Int: slot_no), 
      EXIT (R0! = PCMCIA_PowerFlags: flags_out)
   );

SWI PCMCIA_FSOp =
   (  NUMBER 0x47507 "Provides various PCMCIA operations for use by
            the filer and filing systems -
      see individual reason codes",
      ABSENT
   );

TYPE PCMCIA_PartitionType = .Int;
CONST PCMCIA_PartitionTypePCCardFS = PCMCIA_PartitionType: 0,
      PCMCIA_PartitionTypeDriver   = PCMCIA_PartitionType: 1;

SWI PCMCIAFSOp_GetPartitionInfo =
   (  NUMBER 0x47507,
      ENTRY (R0 # 0 "Returns info for the partition currently mapped
            onto the a card drive",
            R1 = .Int: slot_no), 
      EXIT (R0 -> .Data: start_phys_addr,
            R1 = .Int: length,
            R2 = PCMCIA_PartitionType: type)
   );

SWI PCMCIAFSOp_GetCardDriveNumber =
   (  NUMBER 0x47507,
      ENTRY (R0 # 1 "Returns the number of card drives allocated for
            filing-sytem use by the PCMCIA Manager"),
      EXIT (R0! = .Int: slot_count)
   );

SWI PCMCIAFSOp_GetSRAMSize =
   (  NUMBER 0x47507,
      ENTRY (R0 # 2 "Returns the size of an uninitialised SRAM card",
            R1 = .Int: slot_no), 
      EXIT (R0! = .Int: size)
   );

SWI PCMCIAFSOp_UpdatePartitionData =
   (  NUMBER 0x47507,
      ENTRY (R0 # 3 "Updates the partition data",
            R1 = .Int: slot_no,
            R2 -> .Data: start_phys_addr,
            R3 = .Int: length,
            R4 -> .Data: data)
   );

TYPE PCMCIA_ServiceReason = .Int;
CONST
PCMCIA_ServiceManagerStarted          = PCMCIA_ServiceReason: 1,
PCMCIA_ServiceManagerFinished         = PCMCIA_ServiceReason: 2,
PCMCIA_ServiceHardwareDriverStarted   = PCMCIA_ServiceReason: 3,
PCMCIA_ServiceHardwareDriverFinished  = PCMCIA_ServiceReason: 4,
PCMCIA_ServicePCCardDriverStarted     = PCMCIA_ServiceReason: 5,
PCMCIA_ServicePCCardDriverFinished    = PCMCIA_ServiceReason: 6;

SWI
   // Extends OS_ServiceCall
   Service_PCMCIA =
   (  NUMBER 0x30,
      ENTRY
      (  R0 = PCMCIA_ServiceReason: reason,
         R1 # &9C "PCMCIA service call"
      ),
      EXIT
      (R1?
   )  )
